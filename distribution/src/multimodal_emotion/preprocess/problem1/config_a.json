    "sample_rate": 16000, "frame_ms": 25, "hop_ms": 10,
    "frame_energy_floor": 1e-06, "tau_a_percentile": 5.0, "k_min": 2, "covarep_hop_sec": 0.01
  },
  "vision": {
    "backend": "openface", "tau_v": 0.5, "confidence_min": 0.8,
    "black_mean_max": 5.0, "white_mean_min": 250.0, "blur_var_min": 20.0
  }
}
