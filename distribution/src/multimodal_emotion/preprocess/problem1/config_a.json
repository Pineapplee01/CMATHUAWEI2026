{
  "L": 50,
  "paths": {
    "labels": "data/appendix_1/mosei_raw_videos_100/label-100.xlsx",
    "video_root": "data/appendix_1/mosei_raw_videos_100",
    "qc": "results/appendix_1/media_qc/results_full.csv",
    "bert": "reference/models/bert-base-uncased",
    "openface": "reference/tools/openface/FeatureExtraction",
    "covarep": "reference/tools/covarep",
    "matlab": "matlab",
    "output": "results/appendix_1/method_a",
    "dictionary": "reference/tools/mfa/english_us_arpa_v3.0.0.dict",
    "acoustic": "reference/tools/mfa/english_us_arpa_acoustic_v3.0.0.zip"
  },
  "mfa": {
    "mfa_executable": "mfa",
    "fallback_uniform": false,
    "reuse_mfa_root": "results/appendix_1/_tmp_mfa"
  },
  "av_sync": { "common_hop_sec": 0.04 },
  "text": { "padding": "max_length", "truncation": true },
