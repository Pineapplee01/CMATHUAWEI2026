{
  "data": "../_data/aligned_50.pkl",
  "bert": "~/CPMCM/AAAmodel/bert-base-uncased",
  "sequence_length": 50,
  "audio_dim": 74,
  "vision_dim": 35,
  "selection_split": "valid",
  "selection_metric": "MAE",
  "primary_f1": "macro",
  "additional_f1": ["weighted", "per_class"],
